@model List<Hara_Midterm_Store.Models.CartItem>
@{ ViewData["Title"] = "Cart"; }

<h1>Your Cart</h1>

<table class="table table-bordered align-middle">
    <thead>
        <tr><th>Product Name</th><th>Price</th><th>Quantity</th><th>Subtotal</th><th>Actions</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Price</td>
                <td>
                    <form asp-action="Update" method="post" class="d-flex gap-2">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control" style="width:90px" />
                        <button type="submit" class="btn btn-sm btn-primary">Update</button>
                    </form>
                </td>
                <td>@(item.Price * item.Quantity)</td>
                <td>
                    <a asp-action="Remove" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Remove</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<h4 class="text-end">Total: @ViewBag.Total</h4>
<a asp-controller="Products" asp-action="Index" class="btn btn-secondary">Back to Products</a>